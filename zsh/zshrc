# Port forward: kpf svc/api 8080:80 [namespace]
kpf() {
  (( $# >= 2 )) || { echo "Usage: kpf <svc/name|pod/name|name> <local:remote> [namespace]"; return 1 }
  kubectl port-forward -n "${3:-default}" "$1" "$2"
}
# Logs: klog <pod> [container] [namespace]
klog() {
  (( $# >= 1 )) || { echo "Usage: klog <pod> [container] [namespace]"; return 1 }
  local pod=$1 container=$2 ns=${3:-default}
  kubectl logs -n "$ns" --tail=200 -f "$pod" ${container:+-c "$container"}
}

