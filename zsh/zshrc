# Generate a completion file only when the binary is newer than the cached copy
_comp() {  # _comp <_file> <cmd> [args...]
  local file=$ZCOMP_DIR/$1 cmd=$2; shift 2
  (( $+commands[$cmd] )) || return
  [[ -s $file && $file -nt $commands[$cmd] ]] && return
  "$cmd" "$@" > $file 2>/dev/null || rm -f $file
}

