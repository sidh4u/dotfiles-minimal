# Prompt with git details
_git_prompt=$HOME/.git-prompt.sh
if [[ ! -s $_git_prompt ]]; then
  curl -fsS https://raw.githubusercontent.com/git/git/master/contrib/completion/git-prompt.sh \
    -o "$_git_prompt" || rm -f "$_git_prompt"
fi
if [[ -s $_git_prompt ]]; then
  GIT_PS1_SHOWCOLORHINTS=true       # Colour branch by state - green clean, red detached
  GIT_PS1_SHOWDIRTYSTATE=true       # * unstaged, + staged, # repo has no commits yet
  GIT_PS1_SHOWSTASHSTATE=true       # $ something is stashed
  GIT_PS1_SHOWUNTRACKEDFILES=true   # % untracked files present
  GIT_PS1_SHOWUPSTREAM="auto"       # < behind, > ahead, <> diverged, = in sync
  GIT_PS1_STATESEPARATOR=" "        # Gap between branch name and the flags above
  GIT_PS1_DESCRIBE_STYLE="default"  # Detached HEAD as exact tag; else (short-sha...)
  GIT_PS1_HIDE_IF_PWD_IGNORED=true  # No prompt decoration inside gitignored dirs
  GIT_PS1_COMPRESSSPARSESTATE=true  # ? instead of |SPARSE for sparse checkouts
  source "$_git_prompt"
  setopt PROMPT_SUBST
  precmd_functions+=(_set_prompt)
  # Flag order in output: ? * + $ % then upstream. In-progress ops append
  # |REBASE 1/3, |MERGING, |CHERRY-PICKING, |REVERTING, |AM, |BISECTING
  _set_prompt() { __git_ps1 '%F{blue}%~%f ' ' %F{blue}%(!.#.>)_%f ' '(⎇ %s)' }
else
  PROMPT='%F{blue}%~%f %F{blue}%(!.#.>)_%f '
fi
unset _git_prompt
PROMPT_EOL_MARK=''

# History settings
HISTFILE=~/.zsh_history
HISTSIZE=200000
SAVEHIST=100000
setopt bang_hist                # Treat ! special during command expansion
setopt extended_history         # Write history in :start:elapsed;command format
setopt share_history            # Share history among all sessions (implies inc_append_history, append_history)
setopt hist_expire_dups_first   # Expire duplicates first when trimming history
setopt hist_find_no_dups        # When searching history, don't repeat
setopt hist_ignore_all_dups     # Delete old recorded entry if new entry is a duplicate
setopt hist_save_no_dups        # Don't write duplicate entries in the history file
setopt hist_ignore_space        # Prefix command with a space to skip its recording
setopt hist_reduce_blanks       # Remove extra blanks from each command added to history
setopt hist_verify              # Don't execute immediately upon history expansion
setopt hist_no_store            # Don't record 'history'/'fc' commands themselves
unsetopt hist_beep              # No beep on nonexistent history
# history selects by position: 'history', 'history -20', 'history 100 200'
history() {
  if (( $# )); then
    builtin history -i "$@"
  else
    builtin history -i 1
  fi
}
# h searches by content: 'h docker', 'h git commit'
h() {
  if (( $# )); then
    builtin history -i 1 | grep -i -- "$*"
  else
    builtin history -i 1
  fi
}

